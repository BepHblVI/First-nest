{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env*", "**/.env*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:integration": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "m:gen": {
      "cache": false
    },
    "m:run": {
      "cache": false
    },
    "codegen": {
      "dependsOn": ["backend#build"],
      "inputs": ["../backend/src/schema.gql", "src/**/*.{ts,tsx,graphql}", "codegen.ts"],
      "outputs": ["src/gql/**"]
    },
    "typecheck": {
      "dependsOn": ["codegen"]
    }
  }
}
